-- Drag logic
local dragging = false
local dragStart = nil
local startPos = nil

local function getVP()
    return workspace.CurrentCamera.ViewportSize
end

Main.Position = UDim2.new(0, (getVP().X - 480) / 2, 0, (getVP().Y - 270) / 2)
Main.AnchorPoint = Vector2.new(0, 0)

local function attachDrag(bar)
    bar.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = Vector2.new(inp.Position.X, inp.Position.Y)
            startPos = Vector2.new(Main.Position.X.Offset, Main.Position.Y.Offset)
        end
    end)
    bar.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

UserInputService.InputChanged:Connect(function(inp)
    if not dragging then return end
    if inp.UserInputType ~= Enum.UserInputType.MouseMovement
    and inp.UserInputType ~= Enum.UserInputType.Touch then return end
    local vp = getVP()
    local delta = Vector2.new(inp.Position.X, inp.Position.Y) - dragStart
    local newX = math.clamp(startPos.X + delta.X, 0, vp.X - Main.AbsoluteSize.X)
    local newY = math.clamp(startPos.Y + delta.Y, 0, vp.Y - Main.AbsoluteSize.Y)
    Main.Position = UDim2.new(0, newX, 0, newY)
end)

UserInputService.TouchMoved:Connect(function(touch)
    if not dragging then return end
    local vp = getVP()
    local delta = Vector2.new(touch.Position.X, touch.Position.Y) - dragStart
    local newX = math.clamp(startPos.X + delta.X, 0, vp.X - Main.AbsoluteSize.X)
    local newY = math.clamp(startPos.Y + delta.Y, 0, vp.Y - Main.AbsoluteSize.Y)
    Main.Position = UDim2.new(0, newX, 0, newY)
end)
UserInputService.TouchEnded:Connect(function()
    dragging = false
end)


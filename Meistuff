local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function corner(r, p) return new("UICorner", {CornerRadius = UDim.new(0, r)}, p) end
local function stroke(c, t, p, tr)
    return new("UIStroke", {Color = c, Thickness = t or 1, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, p)
end
local function tween(o, t, props)
    TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function getParent()
    local ok, ui = pcall(function() return gethui and gethui() end)

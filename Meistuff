local toastToken = 0
local function notify(text, color)
    toastToken += 1
    local token = toastToken
    toast.Text = text
    toast.TextColor3 = color or Theme.Text
    tween(toast, { Position = UDim2.new(0.5, -110, 1, -36) }, 0.25)
    task.delay(2, function()
        if token == toastToken then
            tween(toast, { Position = UDim2.new(0.5, -110, 1, 40) }, 0.25)
        end
    end)
end

--// Logic
local currentIndex = 1
local busy = false
local tabButtons = {}

local function setStatus(text, color)
    status.Text = text
    status.TextColor3 = color or Theme.SubText
end

local function runCode(code)
    if not loadstring then return false, "This executor is not supported" end
    local fn, err = loadstring(code)
    if not fn then return false, err end
    return pcall(fn)
end

local function refreshOrder()
    for i, entry in ipairs(tabButtons) do
        local fav = Save.Favorites[TABS[i].Name]
        entry.Button.LayoutOrder = fav and (i - 1000) or i
        entry.Dot.Visible = fav and true or false
    end
end

local function refreshFavButton()
    local fav = Save.Favorites[TABS[currentIndex].Name]
    favBtn.Text = fav and "FAVORITED" or "ADD FAVORITE"
    favBtn.TextColor3 = fav and Theme.Gold or Theme.AccentDim
end

local function refreshRunCount(i)
    local n = Save.Runs[TABS[i].Name] or 0
    tabButtons[i].Runs.Text = n > 0 and ("x" .. n) or ""
end

local function selectTab(index)
    currentIndex = index
    local tab = TABS[index]
    tabTitle.Text = tab.Name
    tabDesc.Text = tab.Desc
    setStatus("Ready.", Theme.SubText)
    refreshFavButton()

    for i, entry in ipairs(tabButtons) do
        local active = (i == index)
        tween(entry.Button, {
            BackgroundColor3 = active and Theme.ItemHover or Theme.Item,
            TextColor3 = active and Theme.Accent or Theme.SubText,
        })
        tween(entry.Bar, { BackgroundTransparency = active and 0 or 1 })
    end
end

execBtn.MouseButton1Click:Connect(function()
    if busy then return end
    busy = true
    local index = currentIndex
    local tab = TABS[index]

    execBtn.Text = "EXECUTING..."
    tween(execBtn, { BackgroundColor3 = Theme.AccentDim })
    setStatus("Running " .. tab.Name .. "...", Theme.AccentDim)
    addLog("Running " .. tab.Name .. "...")

    task.spawn(function()
        local ok, err = runCode(tab.Code)

        if ok then
            Save.Runs[tab.Name] = (Save.Runs[tab.Name] or 0) + 1
            writeSave()
            refreshRunCount(index)
            execBtn.Text = "EXECUTED"
            setStatus(tab.Name .. " executed successfully.", Theme.Success)
            addLog(tab.Name .. " executed.", Theme.Success)
            notify(tab.Name .. " executed", Theme.Success)
        else
            local msg = tostring(err):sub(1, 70)
            execBtn.Text = "FAILED"
            setStatus("Error: " .. msg, Theme.Error)
            addLog("Error: " .. msg, Theme.Error)
            notify(tab.Name .. " failed", Theme.Error)
        end

        task.wait(1)
        execBtn.Text = "EXECUTE"
        tween(execBtn, { BackgroundColor3 = Theme.Accent })
        busy = false
    end)
end)

copyBtn.MouseButton1Click:Connect(function()

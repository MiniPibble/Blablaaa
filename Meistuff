-- ===== FUNCTIONS =====
local function SetStatus(txt, col)
    StatLbl.Text = txt
    StatDot.BackgroundColor3 = col
end

local function LoadTab(idx)
    ActiveTab = idx
    local t = Tabs[idx]
    local glowColor = TabColors[idx]

    TabNameLbl.Text = "Tab " .. idx .. "  —  " .. t.Name
    TabNameLbl.TextColor3 = glowColor
    TabMetaLbl.Text = "™  selected"
    CodeLbl.Text = t.Code

    for i, btn in ipairs(TabButtons) do
        local isActive = (i == idx)
        local col = TabColors[i]
        local glowBg = Color3.fromRGB(
            math.floor(col.R * 255 * 0.08),
            math.floor(col.G * 255 * 0.08),
            math.floor(col.B * 255 * 0.08)
        )

        if isActive then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = glowBg}):Play()
        else
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = C_PANEL}):Play()
        end

        local acc = btn:FindFirstChild("Accent")
        acc.Visible = isActive
        if isActive then
            TweenService:Create(acc, TweenInfo.new(0.2), {BackgroundColor3 = col}):Play()
        end

        local lbl = btn:FindFirstChild("TabLabel")
        TweenService:Create(lbl, TweenInfo.new(0.2), {
            TextColor3 = isActive and col or C_DIM
        }):Play()

        local num = btn:FindFirstChild("Num")
        TweenService:Create(num, TweenInfo.new(0.2), {
            TextColor3 = isActive and col or Color3.fromRGB(60,60,60)
        }):Play()

        local ind = btn:FindFirstChild("Indicator")
        TweenService:Create(ind, TweenInfo.new(0.2), {
            BackgroundColor3 = isActive and col or Color3.fromRGB(35,35,35)
        }):Play()
    end

    ExecBtn.BackgroundColor3 = glowColor
    ExecBtn.Text = "EXECUTE"
    SetStatus("READY", C_GREEN)
end


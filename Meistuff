    TabButtons[i] = Btn

    Btn.MouseEnter:Connect(function()
        if i ~= ActiveTab then
            TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(18,18,18)}):Play()
        end
    end)
    Btn.MouseLeave:Connect(function()
        if i ~= ActiveTab then
            TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = C_PANEL}):Play()
        end
    end)
    Btn.MouseButton1Click:Connect(function()
        LoadTab(i)
    end)
end

-- Execute button logic
ExecBtn.MouseButton1Click:Connect(function()
    local t = Tabs[ActiveTab]
    if t.Code == "" then
        SetStatus("EMPTY TAB", C_DIM)
        ExecBtn.Text = "EMPTY"
        task.delay(1.5, function()
            ExecBtn.BackgroundColor3 = TabColors[ActiveTab]
            ExecBtn.Text = "EXECUTE"
            SetStatus("READY", C_GREEN)
        end)
        return
    end

    SetStatus("EXECUTING", C_YELLOW)
    ExecBtn.BackgroundColor3 = C_YELLOW
    ExecBtn.Text = "..."

    task.spawn(function()
        local ok, err = pcall(function()
            loadstring(t.Code)()
        end)
        if ok then
            SetStatus("SUCCESS", C_GREEN)
            ExecBtn.BackgroundColor3 = C_GREEN
            ExecBtn.Text = "✓ DONE"
        else
            SetStatus("ERROR", Color3.fromRGB(220, 60, 60))
            ExecBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
            ExecBtn.Text = "✗ ERROR"
            warn("[Yui] Execute error: " .. tostring(err))
        end
        task.delay(2, function()
            ExecBtn.BackgroundColor3 = TabColors[ActiveTab]
            ExecBtn.Text = "EXECUTE"
            SetStatus("READY", C_GREEN)
        end)
    end)
end)

ExecBtn.MouseEnter:Connect(function()
    if ExecBtn.Text == "EXECUTE" then
        local c = TabColors[ActiveTab]
        TweenService:Create(ExecBtn, TweenInfo.new(0.1), {
            BackgroundColor3 = Color3.fromRGB(
                math.min(255, math.floor(c.R*255*1.2)),
                math.min(255, math.floor(c.G*255*1.2)),
                math.min(255, math.floor(c.B*255*1.2))
            )
        }):Play()
    end
end)

ExecBtn.MouseLeave:Connect(function()
    if ExecBtn.Text == "EXECUTE" then
        TweenService:Create(ExecBtn, TweenInfo.new(0.1), {BackgroundColor3 = TabColors[ActiveTab]}):Play()
    end
end)

